# ---------------------------------------------------------------------------
# TFA environment — template.
#
# Copy to `env` and fill in. The real `env` is gitignored: it carries an API
# key and a database password, and neither belongs in a repository.
#
# Read at startup and re-read on every run, so editing this file and pressing
# Run picks up the change with no restart. An `export` in the shell always wins
# over anything set here.
#
# The filings folder holds a client's tax returns. A key sitting beside them
# travels with them when the folder is copied — this file is gitignored, and
# before this goes anywhere real the key belongs in the shell or a secret
# manager and this file belongs empty.
# ---------------------------------------------------------------------------

# Required for the judgment rules, the open-ended anomaly scan and the question
# box. Leave it empty and TFA still runs every deterministic rule, reporting the
# model-dependent parts as not assessed rather than as passed.
ANTHROPIC_API_KEY=

# Model pinned into the run manifest. Changing it changes the run.
TFA_MODEL=claude-opus-5

# Cheaper model, for high-volume extraction passes.
TFA_MODEL_FAST=claude-sonnet-5

# Judgment must be reproducible. Leave at 0 unless deliberately measuring variance.
TFA_TEMPERATURE=0

# Ceiling on model calls for a single analysis. 0 permits none; -1 removes the
# ceiling. A number that reads as "stop" must not mean "go".
TFA_MAX_MODEL_CALLS=300

# Cached model responses, keyed on content hash: re-running an unchanged set of
# filings costs nothing and returns the same verdicts.
TFA_CACHE_DIR=.tfa-cache

# Where the client folders live. One folder per client under this root.
TFA_FILINGS_DIR=filings

# simulation | production. Production refuses an unverified authority pack.
TFA_RUN_MODE=simulation

# ---------------------------------------------------------------------------
# Persistence.
#
# The analysis itself needs no database: leave this empty and every rule still
# runs, and the screen says the run was not recorded. What is lost without it
# is the register — the matters, who decided what about them, and the enquiries
# raised and answered. That is the part that cannot be recomputed.
#
# For a single machine, `python3 -m tfa.store.local start` runs an embedded
# Postgres out of ~/.tfa/pgdata and prints the URL to paste here. For anything
# shared, point this at a real server and a database of TFA's own — client tax
# data does not belong in another application's schema.
#
# Set it to `off` to turn recording off deliberately — an empty value means
# "look in the shell", which is not the same statement.
#
# This line carries a password. It is never written to the manifest, never
# logged, and shown on screen only with the password removed.
# ---------------------------------------------------------------------------
TFA_DB_URL=
